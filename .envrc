# Load nix environment with caching
if ! has nix_direnv_version || ! nix_direnv_version 2.3.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/2.3.0/direnvrc" "sha256-Dmd+j63L84wuzgyjITIfSxSD57Tx7v51DMxVZOsiUD8="
fi

use nix

# Export library paths for PyTorch/CUDA (these come from shell.nix but need to be explicitly set for direnv)
GCC_LIB=$(echo /nix/store/*-gcc-14.*-lib/lib | cut -d' ' -f1)
export LD_LIBRARY_PATH="$GCC_LIB:$LD_LIBRARY_PATH"

# Create and activate Python virtual environment
VENV_DIR=".venv"
if [ ! -d "$VENV_DIR" ]; then
  echo "Creating Python virtual environment..."
  python -m venv "$VENV_DIR"
fi

source "$VENV_DIR/bin/activate"

# Ensure pip is up to date
if [ ! -f "$VENV_DIR/.pip_upgraded" ]; then
  echo "Upgrading pip..."
  pip install --upgrade pip setuptools wheel
  touch "$VENV_DIR/.pip_upgraded"
fi

echo "✓ Virtual environment activated: $VIRTUAL_ENV"
